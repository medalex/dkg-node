# syntax=docker/dockerfile:1
FROM node:20.11.0-bookworm

# ── 1. System deps ────────────────────────────────────────────────────────────
# default-mysql-server → MariaDB on bookworm (ot-node uses sequelize/mysql2)
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jre-headless \
    git \
    wget \
    curl \
    netcat-openbsd \
    jq \
    build-essential \
    python3 \
    default-mysql-server \
    redis-server \
 && rm -rf /var/lib/apt/lists/*

# ── 2. ot-node at pinned SHA (vendored) ───────────────────────────────────────
# github.com/OriginTrail/ot-node (later dkg-engine) is no longer public, so the source
# is vendored: `git archive` of commit OTNODE_SHA, see vendor/README.md.
# sha256sum verified at build time. The repo needs a commit: `prepare: husky install` wants .git,
# and the dkg-evm-module deploy scripts record `git rev-parse HEAD` / branch in deployments.json.
# HEAD is detached, as after the original `git checkout ${OTNODE_SHA}`.
ARG OTNODE_SHA=a8156d63132d5584a8adb8307e046ba45c4e7000
ARG OTNODE_TARBALL_SHA256=3700d4da1106475bde95f04fc73634a7136f99e0c57a77cee0ebc6726040ed09
COPY vendor/ot-node-a8156d6.tar.gz /tmp/ot-node.tar.gz
RUN echo "${OTNODE_TARBALL_SHA256}  /tmp/ot-node.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/ot-node.tar.gz -C /opt \
 && rm /tmp/ot-node.tar.gz \
 && git -C /opt/ot-node init -q \
 && git -C /opt/ot-node add -A \
 && git -C /opt/ot-node -c user.name=dkg-local -c user.email=dkg-local@localhost \
        commit -q -m "ot-node ${OTNODE_SHA} (vendored, see vendor/README.md)" \
 && git -C /opt/ot-node checkout -q --detach

# ── 3. npm install ────────────────────────────────────────────────────────────
# Separate layer: cached as long as OTNODE_SHA (and thus package.json) doesn't change.
# devDependencies included — Hardhat + dkg-evm-module deploy scripts live there.
#
# --mount=type=cache persists ~/.npm on the Docker host between builds.
# If the build fails mid-download, the next run resumes from cached tarballs.
# fetch-timeout=600000 gives each tarball up to 10 min (needed on Rosetta/M-series).
WORKDIR /opt/ot-node

# dkg-evm-module is a git dependency on github.com/OriginTrail/dkg-evm-module, which is gone
# as well; the locked commit is vendored as an npm tarball (see vendor/README.md).
# Git must fail fast instead of waiting for credentials if another git dependency appears.
ENV GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -o BatchMode=yes"
ARG EVM_MODULE_TARBALL_SHA256=570d9d27c97ca7cd1334ac13c6758f5f3c458c460f03324dcff474f787e385b6
COPY vendor/dkg-evm-module-1088476.tgz /opt/vendor/dkg-evm-module-1088476.tgz
RUN echo "${EVM_MODULE_TARBALL_SHA256}  /opt/vendor/dkg-evm-module-1088476.tgz" | sha256sum -c - \
 && npm pkg set dependencies.dkg-evm-module=file:/opt/vendor/dkg-evm-module-1088476.tgz

# NPM_LOGLEVEL=http (with --progress=plain) shows each download and install script.
ARG NPM_LOGLEVEL=warn
RUN --mount=type=cache,target=/root/.npm \
    npm config set fetch-timeout 600000 \
 && npm install \
      --fetch-retries=5 \
      --fetch-retry-mintimeout=30000 \
      --fetch-retry-maxtimeout=300000 \
      --maxsockets=3 \
      --foreground-scripts \
      --loglevel=${NPM_LOGLEVEL}

# ── 4. Pre-download Solidity compiler ────────────────────────────────────────
# Hardhat fetches solc at first run; on Rosetta that download hangs.
# Running compile here bakes the binary into the image (~30 MB, cached layer).
# Errors from compilation itself are non-fatal — we only need the download.
RUN --mount=type=cache,target=/root/.cache/hardhat-nodejs \
    cd /opt/ot-node/node_modules/dkg-evm-module \
 && npx hardhat compile --config hardhat.node.config.ts 2>&1 \
 || echo "[build] Hardhat compile finished (errors above may be non-fatal)"

# ── 5. Blazegraph jar ─────────────────────────────────────────────────────────
# Pinned release tag → deterministic URL. sha256sum verified at build time.
# If verification fails: wget jar locally, run sha256sum, update ARG below.
ARG BLAZEGRAPH_URL=https://github.com/blazegraph/database/releases/download/BLAZEGRAPH_2_1_6_RC/blazegraph.jar
ARG BLAZEGRAPH_SHA256=930c38b5bce7c0ae99701c1f6ef3057c52f3f385d938e1397a3e05561c7df5de
RUN wget -q --tries=3 --timeout=60 -O /opt/blazegraph.jar "${BLAZEGRAPH_URL}" \
 && echo "${BLAZEGRAPH_SHA256}  /opt/blazegraph.jar" | sha256sum -c -

# ── 6. Runtime dirs ───────────────────────────────────────────────────────────
RUN mkdir -p /var/log/ot-node /opt/blazegraph-data /opt/ot-node/data

# ── 7. Entrypoint ─────────────────────────────────────────────────────────────
COPY entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r//' /entrypoint.sh && chmod +x /entrypoint.sh

EXPOSE 8900

ENTRYPOINT ["/entrypoint.sh"]
